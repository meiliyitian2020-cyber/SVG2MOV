{
  "name": "svga-mov-exporter",
  "version": "1.2.0",
  "description": "Offline SVGA to transparent MOV exporter",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "Theo",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jszip-utils": "^0.1.0"
  },
  "productName": "SVGA MOV Exporter",
  "build": {
    "appId": "local.theo.svgamov",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "THIRD_PARTY.txt",
        "to": "THIRD_PARTY.txt"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SVGA-MOV-Exporter-1.2.0.exe"
    },
    "directories": {
      "output": "dist-1.2"
    }
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "protobufjs": "^8.8.1"
  }
}