{
  "name": "svga-mov-exporter",
  "version": "1.3.0",
  "description": "将 SVGA 动画导出为带音频的透明 MOV 视频",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "Theo",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jszip-utils": "^0.1.0"
  },
  "productName": "SVGA 转 MOV",
  "build": {
    "appId": "local.theo.svgamov",
    "asar": true,
    "files": [
      "app/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "THIRD_PARTY.txt",
        "to": "THIRD_PARTY.txt"
      }
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "app/assets/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "SVGA转MOV-${version}.exe"
    },
    "directories": {
      "output": "dist-1.3"
    }
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "protobufjs": "^8.8.1"
  },
  "copyright": "Copyright © 2026 Theo"
}
